# R3: the map (`o`) draws a library's shelves as thin boxes along the walls, from the
# books the library exposes as pickables (`Pick::Book`). Here the books are handed in
# with `inject overlay` along the reception's side walls (x 0.15 and 5.85, the back wall
# at z −6.5), the way R6's bookcases stand.
inject overlay {"pickables": [{"book": 1, "pos": [0.15, 1.0, -6.0]}, {"book": 2, "pos": [0.15, 1.3, -5.0]}, {"book": 3, "pos": [0.15, 0.7, -4.0]}, {"book": 4, "pos": [0.15, 1.0, -3.0]}, {"book": 5, "pos": [5.85, 1.0, -6.0]}, {"book": 6, "pos": [5.85, 1.3, -4.5]}, {"book": 7, "pos": [5.85, 1.0, -3.2]}]}
key o
wait 300
expect json /ext/overlay/map/floor false
expect json /ext/overlay/map/shelves 2
shot ${OUT}/shot-ui-map-shelves.png
dump ${OUT}/dump-ui-map-shelves.json
quit

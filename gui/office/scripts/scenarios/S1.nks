# S1 (plano-mundo §1.3): NAV parado, 3 janelas, movimento reduzido. Mede CPU e wakeups ociosos.
# Diretivas #@ são do world-perf.sh (o nkw as lê como comentário); ${RUN} e ${TESTCLIENT}
# são trocados por ele antes de passar o roteiro ao nkw.
#@args --reduced-motion
#@warmup 3000
spawn ${TESTCLIENT} --app-id alpha --color 3366cc --no-frame-wait --log ${RUN}/client-alpha.json
spawn ${TESTCLIENT} --app-id bravo --color cc6633 --no-frame-wait --log ${RUN}/client-bravo.json
spawn ${TESTCLIENT} --app-id demo --checker --no-frame-wait --log ${RUN}/client-demo.json
wait 1500
expect mode NAV
